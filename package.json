{
  "name": "messaging-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first dashboard for comparing Redis, Kafka, and RabbitMQ messaging patterns.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names shared,api,web --prefix-colors yellow,blue,green \"npm run dev --workspace @messaging-lab/shared\" \"npm run dev --workspace @messaging-lab/api\" \"npm run dev --workspace @messaging-lab/web\"",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:integration": "RUN_BROKER_INTEGRATION=1 vitest run apps/api/src/adapters/adapters.integration.test.ts",
    "test:watch": "vitest",
    "docker:config": "node scripts/compose.mjs config",
    "docker:up": "node scripts/compose.mjs up --build",
    "docker:down": "node scripts/compose.mjs down",
    "docker:logs": "node scripts/compose.mjs logs --follow"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "24.3.0",
    "concurrently": "9.2.4",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vitest": "3.2.7"
  }
}
